# SAKYTI Multilingual NLP Service Configuration

# Service Settings
APP_NAME="SAKYTI Multilingual NLP Service"
APP_ENV=development
DEBUG=false
HOST=0.0.0.0
PORT=8000
API_V1_PREFIX=/api/v1

# Logging Settings
# Options: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO
# Options: json, text
LOG_FORMAT=json

# Model Directory & Path Settings
MODELS_DIR=./data/models
INDICLID_FTN_PATH=./data/models/indiclid-ftn/model_baseline_roman.bin
INDICLID_FTR_PATH=./data/models/indiclid-ftr/model_baseline_roman.bin
INDICTRANS2_MODEL_PATH=./data/models/indictrans2

# Language Detection Settings
LANGUAGE_DETECTION_CONFIDENCE_THRESHOLD=0.40
LANGUAGE_DETECTION_ROMAN_THRESHOLD=0.50

# Hardware / Execution Settings
DEVICE=cpu
NUM_WORKERS=1
